# Local development settings. `cp .env.example .env` and they work as-is with
# `docker compose up`. Every value here is a throwaway for a machine-local
# database: generate new ones for any shared or deployed environment.
# .env is git-ignored; never commit it.

# ---- docker compose: passwords for the db container and the two roles -----
POSTGRES_PASSWORD=local-dev-only-admin
PBO_API_DB_PASSWORD=local-dev-only-api
PBO_IMPORT_DB_PASSWORD=local-dev-only-import

# ---- API ------------------------------------------------------------------
# Comma-separated SHA-256 hex digests of accepted API keys (never the keys).
# This one is the digest of the local key "local-dev-key-change-me"; send it as X-API-Key.
# Make a new key and its digest with:
#   python3 -c "import secrets, hashlib; k = secrets.token_urlsafe(32); print(k); print(hashlib.sha256(k.encode()).hexdigest())"
API_KEY_HASHES=b90fdf19b7020eb94a7805ff1e5b3e3a134a39e6d7e6537b9f6022f60710eb7e
# calendar (Q1 = Jan-Mar) or fiscal (Q1 = Apr-Jun, year = year it starts).
QUARTER_BASIS=calendar
# prod disables /docs and requires API_KEY_HASHES.
ENVIRONMENT=dev
DOCS_ENABLED=true

# ---- Running uv tools on the host against the compose db (127.0.0.1:5433) -
# The compose containers build their own URLs from the passwords above.
MIGRATIONS_DATABASE_URL=postgresql+psycopg://pbo_admin:local-dev-only-admin@127.0.0.1:5433/pbo_workforce
DATABASE_URL=postgresql+psycopg://pbo_api:local-dev-only-api@127.0.0.1:5433/pbo_workforce
IMPORT_DATABASE_URL=postgresql+psycopg://pbo_import:local-dev-only-import@127.0.0.1:5433/pbo_workforce
# Test suite: owner role on a database whose name ends in _test.
TEST_DATABASE_URL=postgresql+psycopg://pbo_admin:local-dev-only-admin@127.0.0.1:5433/pbo_workforce_test
